# ── uwu-api — environment ──────────────────────────────────────────────────────
# Copy to `.env`, fill in real values, then:
#   npx drizzle-kit push   (creates/updates tables)
#   npm start              (build + run)
#
# ⚠️  NEVER commit your real `.env`. This file holds PLACEHOLDERS only.

PORT=4000

# Allow the enterprise dashboard origin (or * for local dev).
CORS_ORIGIN=*

# ── Database (Neon serverless Postgres) ────────────────────────────────────────
# Create a project at https://neon.tech and paste its pooled connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DB?sslmode=require&channel_binding=require

# ── Algorand ───────────────────────────────────────────────────────────────────
ALGORAND_NETWORK=testnet
ALGOD_SERVER=https://testnet-api.algonode.cloud
ALGOD_PORT=443
INDEXER_SERVER=https://testnet-idx.algonode.cloud
INDEXER_PORT=443

# Registry app id for the intent/settlement relayer (OPTIONAL — the dashboard key
# APIs work without it). Use your own deployed app id.
APP_ID=762669103

# 25-word Algorand mnemonic for the relayer/deployer account (must be funded on
# the target network to submit attestation txns).
DEPLOYER_MNEMONIC="word1 word2 word3 ... word25"

# ── DVN threshold signers (base64-encoded Ed25519 64-byte secret keys) ─────────
# Generate one with:
#   node -e "console.log(Buffer.from(require('tweetnacl').sign.keyPair().secretKey).toString('base64'))"
DVN_KEY_1=BASE64_ED25519_SECRET_KEY_1
DVN_KEY_2=BASE64_ED25519_SECRET_KEY_2
DVN_KEY_3=BASE64_ED25519_SECRET_KEY_3
